# Copy to .env and fill in. .env is gitignored — never commit real keys.
SARVAM_API_KEY=
# Optional — only needed for --ai / "Use AI" translation
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Accounts ──────────────────────────────────────────────────────────────────
# Signs login cookies (32+ random chars; ./setup.sh generates one). Required by
# `npm run start:public`. Unset in local dev, a secret is generated into
# <WORKSPACE>/.session_secret. Changing it signs everyone out.
# SESSION_SECRET=
# invite (default): sign-up needs an admin-issued invite code. open: anyone can
# sign up. Either way the very first account becomes the admin.
# SIGNUP_MODE=invite
# Monthly video minutes for new teams (teams owned by an admin are unlimited;
# editable per team on /admin → Teams). Paid plans set their own minutes.
# DEFAULT_MONTHLY_MINUTES=60
# Plan given to new teams (lib/plans.ts id: pilot, free, creator, pro)
# DEFAULT_PLAN=pilot

# ── Email (all optional) ──────────────────────────────────────────────────────
# Any SMTP provider (Resend, Amazon SES, Postmark, Gmail app password …).
# Unset: nothing is sent; each message is written to <WORKSPACE>/outbox/ as JSON.
# SMTP_URL=smtps://user:pass@smtp.resend.com:465
# Sender shown to recipients
# MAIL_FROM=TransEdit <hello@yourdomain.com>
# Public base URL used for links in emails (invites, password resets, "video
# ready"). Set it in production: without it links use the request's Host header.
# APP_URL=https://transedit.yourdomain.com

# ── Payments (all optional; each provider is on only when its vars are set) ──
# Razorpay (₹). Plan ids come from Dashboard → Subscriptions → Plans (monthly).
# Webhook URL: <APP_URL>/api/billing/razorpay/webhook (subscription.* events)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_CREATOR=plan_...
# RAZORPAY_PLAN_PRO=plan_...
# Stripe ($). Price ids of recurring monthly prices. Webhook URL:
# <APP_URL>/api/billing/stripe/webhook (checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_PRO=price_...
# Point the API clients somewhere else (tests / mock servers only)
# RAZORPAY_API_BASE=https://api.razorpay.com
# STRIPE_API_BASE=https://api.stripe.com

# ── Server (all optional) ─────────────────────────────────────────────────────
# How many OCR/translate/render scripts may run at once (default 1)
# MAX_CONCURRENT_JOBS=1
# Delete jobs (and their videos) older than this many days (default: keep)
# JOB_RETENTION_DAYS=
# Largest accepted upload in MB (default 500)
# MAX_UPLOAD_MB=500
# Where jobs and uploads live (default ../workspace relative to loomv2/)
# WORKSPACE_DIR=
# SCRIPTS_DIR=
# Python interpreter for the scripts (default scripts/.venv, then python)
# PYTHON=
# ffprobe binary used to measure uploads (default: ffprobe on PATH)
# FFPROBE=
