# Copy to .env and fill in. .env is gitignored — never commit real keys.
SARVAM_API_KEY=
# Optional — only needed for --ai / "Use AI" translation
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Server (all optional) ─────────────────────────────────────────────────────
# Require a password for the UI and API. Required by `npm run start:public`,
# which listens on all interfaces.
# APP_PASSWORD=
# How many OCR/translate/render scripts may run at once (default 1)
# MAX_CONCURRENT_JOBS=1
# Delete jobs (and their videos) older than this many days (default: keep)
# JOB_RETENTION_DAYS=
# Largest accepted upload in MB (default 500)
# MAX_UPLOAD_MB=500
# Where jobs and uploads live (default ../workspace relative to loomv2/)
# WORKSPACE_DIR=
# SCRIPTS_DIR=
# Python interpreter for the scripts (default scripts/.venv, then python)
# PYTHON=
